  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "security:check": "node scripts/check-dependency-security.mjs",
    "league:snapshot": "node scripts/snapshot-public-league-directory.mjs",
    "calibration:validate": "node scripts/validate-economic-calibration.mjs",
    "calibration:check": "node scripts/validate-economic-calibration.mjs --strict && vitest run tests/calibration-package.test.ts",
    "world:launch": "node scripts/launch-continuous-world.mjs",
    "world:render-launch-sql": "node scripts/render-continuous-world-launch-sql.mjs",
    "world:render-teaching-seed-sql": "node scripts/render-final-world-teaching-seed-sql.mjs",
    "test:world-v2-release-publisher": "vitest run tests/world-v2-release-publisher.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.7",
    "country-region-data": "4.1.0",
    "katex": "0.18.2",
    "lucide-react": "0.545.0",
    "marked": "18.1.1",
    "next": "16.4.2",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.10.0",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.5",
    "supabase": "^2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
