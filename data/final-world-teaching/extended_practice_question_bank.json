{
  "dataset_id": "econmind_extended_practice_question_bank",
  "version": "0.1.0",
  "status": "derived",
  "purpose":"Executable generator for 37 models x 6 binary Correct/Incorrect questions = 222 questions. It avoids copying the base question bank while materializing full, versioned questions at runtime.",
  "source_test_suite":"extended_model_test_suite.json",
  "grading":"A question is Correct only if its stated answer condition is met within numeric tolerance and every locked-variable condition remains true.",
  "question_templates": [
    {"slot":1,"kind":"numeric_formula","prompt":"Using {model_id} and test input {input}, enter {target_field}.","initial_state":"test input from source_test_ref","adjustable":"one numeric answer","locked":"all input values","answer_condition":"abs(answer-expected[target_field]) <= tolerance","explanation":"Substitute compatible-period inputs into the documented formula.","common_error":"using a percentage as a whole number or mixing periods"},
    {"slot":2,"kind":"binary_result","prompt":"For the stated test input, is `{boolean_field}={boolean_value}`?","initial_state":"test input from source_test_ref","adjustable":"Correct or Incorrect","locked":"test input and formula version","answer_condition":"selected boolean equals expected","explanation":"Evaluate the model condition, not an unrelated policy preference.","common_error":"confusing a sufficient condition with a necessary one"},
    {"slot":3,"kind":"unit_check","prompt":"Is `{unit_claim}` a unit-compatible interpretation of this model's primary output?","initial_state":"model notation","adjustable":"Correct or Incorrect","locked":"unit convention","answer_condition":"selected boolean equals unit_claim_truth","explanation":"All rates and quantities must share an explicit time basis.","common_error":"calling a stock a flow or treating percentage points as percent growth"},
    {"slot":4,"kind":"assumption_check","prompt":"Does this claim satisfy the model's stated assumptions: `{assumption_claim}`?","initial_state":"catalog assumptions","adjustable":"Correct or Incorrect","locked":"model boundary","answer_condition":"selected boolean equals assumption_claim_truth","explanation":"The formula is valid only under its declared scope.","common_error":"applying a partial-equilibrium or exogeneity assumption automatically"},
    {"slot":5,"kind":"boundary_check","prompt":"Can the model alone justify this statement: `{boundary_claim}`?","initial_state":"catalog boundary","adjustable":"Correct or Incorrect","locked":"no extra causal/design assumptions","answer_condition":"selected boolean equals boundary_claim_truth","explanation":"A model result is not an unconditional prediction or causal claim.","common_error":"overgeneralising a conditional comparative static"},
    {"slot":6,"kind":"regression_assertion","prompt":"Does `{assertion}` match the regression-test expectation?","initial_state":"source_test_ref","adjustable":"Correct or Incorrect","locked":"test input, tolerance","answer_condition":"selected boolean equals assertion_truth","explanation":"Use the stored expected output and tolerance.","common_error":"rounding outside tolerance or reading a different output field"}
  ],
