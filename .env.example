NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional first-party HTTP gateway. Keep SUPABASE_URL as the original project
# URL so existing sessions and OAuth callbacks keep their original namespace.
# Enable only after deploying and checking infra/cloudflare/supabase-gateway.
NEXT_PUBLIC_SUPABASE_PROXY_URL=
# Canonical public URL used for metadata and social sharing links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sub-path prefix for static hosting (e.g. GitHub Pages). Leave empty for local
# development or a custom domain served from the root.
NEXT_PUBLIC_BASE_PATH=
